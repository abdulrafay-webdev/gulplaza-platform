{
  "expo": {
    "name": "AI Plaza",
    "slug": "ai-plaza-customer",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aiplaza.customer"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#A163F7"
      },
      "package": "com.aiplaza.customer",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to search for matching products with AI."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "501322a4-c109-4a01-929a-44d69fa52ae3"
      }
    }
  }
}
