# Database Configuration (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-sample.aws.neon.tech/neondb?sslmode=require

# ImageKit (Product & Chat Image Uploads)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint

# Authentication
CUSTOMER_JWT_SECRET=your_jwt_secret_key
CLERK_SECRET_KEY=your_clerk_secret_key

# Artificial Intelligence (OpenAI API - Server-side only)
# Required for AI Shopping Advisor, Image Search, and Copywriting
OPENAI_API_KEY=your_openai_api_key_here
